# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Venu Go Backend Configuration (Zero hardcoded defaults — configure per env)
# ---------------------------------------------------------------------------
APP_ENV="development"
PORT="8080"
DATABASE_URL="postgres://postgres:postgres@localhost:5432/venu?sslmode=disable"
REDIS_URL="redis://localhost:6379/0"
ALLOWED_ORIGINS="http://localhost:3000"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false"

# JWT, QR HMAC & MFA Envelope Encryption Secrets
JWT_ACCESS_SECRET="REPLACE_WITH_64_CHAR_RANDOM_ACCESS_SECRET"
JWT_REFRESH_SECRET="REPLACE_WITH_64_CHAR_RANDOM_REFRESH_SECRET"
QR_SIGNING_SECRET="REPLACE_WITH_64_CHAR_RANDOM_QR_SECRET"
MFA_ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_ENCRYPTION_SECRET"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="168h"
MFA_TOKEN_TTL="5m"
TICKET_QR_TTL="24h"
ROTATING_QR_ENABLED="false"
SEAT_HOLD_TTL="9m"
DB_QUERY_TIMEOUT="3s"

# Google OAuth & Firebase Auth / Messaging
GOOGLE_OAUTH_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
FIREBASE_SERVER_KEY="YOUR_FIREBASE_FCM_SERVER_TOKEN"
VITE_GOOGLE_OAUTH_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"

# Razorpay Webhook & Checkout Keys
RAZORPAY_KEY_ID="YOUR_RAZORPAY_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="REPLACE_WITH_RAZORPAY_WEBHOOK_SECRET"

# Server-Side Pricing Rules (Basis Points: 600 = 6.00%)
CONVENIENCE_FEE_BPS="600"
CONVENIENCE_GST_BPS="1800"
ENTERTAINMENT_TAX_BPS="500"
MAX_SEATS_PER_ORDER="12"

# Redis Rate Limiting & HTTP Server Timeouts
RATE_LIMIT_AUTH_MAX="15"
RATE_LIMIT_AUTH_WINDOW="1m"
RATE_LIMIT_HOLD_MAX="30"
RATE_LIMIT_HOLD_WINDOW="1m"
RATE_LIMIT_SCAN_MAX="60"
RATE_LIMIT_SCAN_WINDOW="1m"
RATE_LIMIT_WEBHOOK_MAX="60"
RATE_LIMIT_WEBHOOK_WINDOW="1m"
SHUTDOWN_TIMEOUT="10s"
HTTP_READ_TIMEOUT="10s"
HTTP_WRITE_TIMEOUT="20s"
HTTP_IDLE_TIMEOUT="60s"
HTTP_READ_HEADER_TIMEOUT="5s"
HTTP_REQUEST_TIMEOUT="15s"
