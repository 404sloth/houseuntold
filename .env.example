# ===========================================================================
# Venu Go Backend Configuration (Direct UPI QR + WhatsApp Cloud + Postgres)
# No Razorpay, No PhonePe, No Redis, No Firebase. Zero hardcoded secrets.
# ===========================================================================

# Server & CORS
APP_ENV=development
PORT=8080
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=
COOKIE_SECURE=false
STAFF_CACHE_TTL=30s

# PostgreSQL (pgxpool + sqlc + Postgres rate limiting)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/venu?sslmode=disable
DB_MAX_CONNS=50
DB_MIN_CONNS=10
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_QUERY_TIMEOUT=3s

# Staff JWT & Single-Use Gate QR HMAC-SHA256 Secrets (generate 64+ hex chars)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=venu-api
JWT_AUDIENCE=venu-staff
QR_SIGNING_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
TICKET_QR_TTL=24h

# Direct UPI QR Checkout (Admin manually verifies patron-submitted UTR)
UPI_VPA=merchant@upi
UPI_MERCHANT_NAME=Venu Live Events
UPI_QR_IMAGE_URL=

# Meta WhatsApp Cloud API (Ticket PNG Image + Confirmation Caption Delivery)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WORKERS=6
WHATSAPP_HTTP_TIMEOUT=10s

# Business Rules (GA Ticketing & First 99 Female Rule)
FIRST_99_FEMALE_LIMIT=99
MIN_GUEST_AGE=21

# PostgreSQL Rate Limiting & HTTP Server Timeouts
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_AUTH_WINDOW=1m
RATE_LIMIT_CHECKOUT_MAX=20
RATE_LIMIT_CHECKOUT_WINDOW=1m
RATE_LIMIT_SCAN_MAX=120
RATE_LIMIT_SCAN_WINDOW=1m
RATE_LIMIT_BAR_MAX=180
RATE_LIMIT_BAR_WINDOW=1m
SHUTDOWN_TIMEOUT=15s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=60s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_REQUEST_TIMEOUT=15s
